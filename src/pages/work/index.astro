---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import ContactSection from "../../components/ContactSection.astro";
import StackFilter from "../../components/StackFilter";
import Tag from "../../components/Tag.astro";

const studies = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order,
);

const noteEntries = await Promise.all(
  (await getCollection("notes"))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({
      data: entry.data,
      Content: (await render(entry)).Content,
    })),
);

// Tags worth filtering by: anything that appears in more than one entry.
const counts = new Map<string, number>();
for (const stack of [
  ...studies.map((s) => s.data.stack),
  ...noteEntries.map((n) => n.data.stack),
]) {
  for (const item of stack) counts.set(item, (counts.get(item) ?? 0) + 1);
}
const filterTags = [...counts.entries()]
  .filter(([tag, count]) => count > 1 && !tag.includes("legacy"))
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12)
  .map(([tag]) => tag);
---

<Layout
  title="Work"
  description="Production systems built over three years: multi-tenant SaaS, payments infrastructure, point-of-sale hardware and mobile apps, written up as case studies."
>
  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <a
      href="/#work"
      class="font-mono text-xs text-muted transition-colors hover:text-trace"
    >
      &larr; Back
    </a>

    <h1 class="mt-6 font-display text-4xl font-semibold text-paper sm:text-5xl">
      Work
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Three years of commercial delivery. The code is private, so the work is
      written up instead: the problem, the architecture, and the trade-offs I
      would defend in a room. Client and product names are left out on purpose.
      The decisions are the part that transfers.
    </p>

    <div class="mt-10">
      <StackFilter client:idle tags={filterTags} targetId="work-list" />
    </div>

    <div id="work-list" class="mt-12">
      <section data-group="studies">
        <h2 class="font-mono text-xs uppercase tracking-[0.15em] text-signal">
          Case studies
        </h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {
            studies.map((entry) => (
              <div data-stack={entry.data.stack.join("|")} class="grid">
                <CaseStudyCard entry={entry} />
              </div>
            ))
          }
        </div>
      </section>

      <section data-group="notes" class="mt-20">
        <h2 class="font-mono text-xs uppercase tracking-[0.15em] text-signal">
          Also shipped
        </h2>
        <p class="mt-3 max-w-2xl text-muted">
          Smaller pieces of work that do not need a full write-up, kept here so
          the record is complete rather than only the headline projects.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            noteEntries.map(({ data, Content }) => (
              <article
                data-stack={data.stack.join("|")}
                class="flex flex-col gap-3 rounded-lg border border-panel-line bg-panel p-6"
              >
                <h3 class="font-display text-lg font-semibold text-paper">
                  {data.title}
                </h3>
                <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted">
                  {data.context}
                </p>
                <p class="text-sm text-paper/90">{data.summary}</p>
                <div class="note-body text-sm leading-relaxed text-muted">
                  <Content />
                </div>
                <div class="mt-auto flex flex-wrap gap-2 pt-2">
                  {data.stack.slice(0, 5).map((item) => <Tag label={item} />)}
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <div class="border-t border-panel-line">
    <ContactSection />
  </div>
</Layout>
