---
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import { CONTACT, SHOW_RESUME } from "../lib/site";

const TIMELINE = [
  {
    period: "2013–2022",
    title: "Camera assistant and operator",
    detail:
      "Close to ten years in broadcast television, primarily at the Australian Broadcasting Corporation, with freelance work across other networks including a US television series. Live production teaches you what shipping under real conditions actually costs.",
  },
  {
    period: "2022–2023",
    title: "Diploma of Information Technology",
    detail:
      "Full stack web development at Coder Academy. A deliberate career change, not a hedge.",
  },
  {
    period: "2023",
    title: "Junior developer",
    detail:
      "Started as an intern at Octivo / TMRW Group and was brought on in a paid role. MERN stack work across front end and back end, including a Three.js content block for a drag-and-drop course builder.",
  },
  {
    period: "2023–2026",
    title: "Junior engineer, then software engineer",
    detail:
      "Three years of production delivery at Distinct ICT in Geelong: multi-tenant SaaS, payments infrastructure, React Native apps in both app stores, DevOps across Render and Vercel, and client work on site.",
  },
  {
    period: "Now",
    title: "Looking for the next role",
    detail:
      "Available immediately, taking contract work in the meantime, and building side projects in stacks I want more reps in.",
  },
];

---

<Layout
  title="About"
  description="From ten years in broadcast television to full stack engineering: what I've built, how I work, and what I'm looking for."
>
  <article class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <div class="max-w-3xl">
      <h1 class="font-display text-4xl font-semibold text-paper sm:text-5xl">
        About
      </h1>

      <div class="case-body mt-10">
        <p>
          I spent close to ten years in broadcast television before I wrote a
          line of production code, as a camera assistant and then an operator.
          Live television has a useful quality: it either goes to air or it does
          not, and nobody is interested in why the rig worked yesterday. That is
          most of why I care about systems holding up under real conditions
          rather than in a demo.
        </p>
        <p>
          Since then I have spent three years shipping production software end
          to end: multi-tenant platforms, payments infrastructure, mobile apps
          in both app stores, and the DevOps around them. That code is
          commercial and stays private, so the systems are written up as <a
            href="/#work">case studies</a
          > instead.
        </p>

        <h2>The path here</h2>
      </div>

      <ol class="mt-8 border-l border-panel-line">
        {
          TIMELINE.map((item) => (
            <li class="relative pb-10 pl-6 last:pb-0">
              <span
                class="absolute -left-[4.5px] top-2 h-2 w-2 rounded-full bg-signal"
                aria-hidden="true"
              />
              <p class="font-mono text-xs tracking-[0.1em] text-signal">
                {item.period}
              </p>
              <h3 class="mt-2 font-display text-xl font-semibold text-paper">
                {item.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted">{item.detail}</p>
            </li>
          ))
        }
      </ol>

      <div class="case-body mt-16 border-t border-panel-line pt-10">
        <h2>What I'm looking for</h2>
        <p>
          A mid-level engineering role, Melbourne hybrid or remote, available
          now. Most of what I have shipped is full stack across web and mobile,
          and I am equally happy owning a backend system or a front-end build on
          its own. The range means I can plug in where a team actually needs
          someone, rather than only where my last job happened to sit.
        </p>
      </div>

      {
        SHOW_RESUME && (
          <a
            href={CONTACT.resumeHref}
            class="mt-10 inline-block rounded bg-signal px-5 py-3 font-mono text-sm text-ink transition-opacity hover:opacity-90"
          >
            Download résumé (PDF)
          </a>
        )
      }
    </div>
  </article>

  <div class="border-t border-panel-line">
    <ContactSection />
  </div>
</Layout>
